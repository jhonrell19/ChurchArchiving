# Next.js / Prisma
DATABASE_URL="file:./dev.db"

# Next.js -> Flask private service connection
FLASK_API_URL="http://127.0.0.1:5000"

# Generate a long random value. The SAME value is read by Next.js and Flask.
FLASK_INTERNAL_KEY="replace-with-a-long-random-secret"

# Flask-only application secret
FLASK_SECRET_KEY="replace-with-a-different-long-random-secret"

# Optional Flask DB override. Default: sqlite:///archive.db
# ARCHIVE_DATABASE_URL="sqlite:///archive.db"

# Local development only. Do not set to 1 in production.
FLASK_DEBUG="0"

# Public application URL used in verification/reset links
APP_BASE_URL="http://localhost:3000"

# Optional transactional email provider (Resend).
# Leave blank for local development; the UI will expose a development-only link.
RESEND_API_KEY=""
EMAIL_FROM="Smart Parish <no-reply@your-domain.com>"

# Payment mode. Current code ships with DEMO payment enabled for capstone testing.
# Real PayMongo/QR Ph activation requires merchant credentials and webhook setup.
PAYMENT_MODE="DEMO"
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
