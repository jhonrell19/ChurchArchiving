# Next.js / Prisma
DATABASE_URL="file:./dev.db"

# Still used by the existing reset-password token endpoint.
JWT_SECRET="replace-with-a-long-random-secret"

# Next.js -> Flask private service connection
FLASK_API_URL="http://127.0.0.1:5000"

# Generate a long random value. The SAME value is read by Next.js and Flask.
FLASK_INTERNAL_KEY="replace-with-a-long-random-secret"

# Flask-only application secret
FLASK_SECRET_KEY="replace-with-a-different-long-random-secret"

# Optional Flask DB override. Default: sqlite:///archive.db
# ARCHIVE_DATABASE_URL="sqlite:///archive.db"

# Local development only. Do not set to 1 in production.
FLASK_DEBUG="0"
