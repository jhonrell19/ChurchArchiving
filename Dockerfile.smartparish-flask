FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg tesseract-ocr \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY church_backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt 'gunicorn>=22,<26'
COPY church_backend/ /app/church_backend/
COPY scripts/migrate_payment_ledger.py /app/scripts/migrate_payment_ledger.py
COPY deploy/render-start-flask.sh /app/deploy/render-start-flask.sh
CMD ["sh", "/app/deploy/render-start-flask.sh"]
