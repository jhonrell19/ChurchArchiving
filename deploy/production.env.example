# Example ONLY. Never commit the filled-in production environment file.
NODE_ENV=production
SMART_PARISH_ENV=production
APP_BASE_URL=https://parish.example.com
DATABASE_URL=file:/srv/smartparish/data/dev.db
ARCHIVE_DATABASE_URL=sqlite:////srv/smartparish/data/archive.db
SMART_PARISH_UPLOAD_ROOT=/srv/smartparish/uploads
FLASK_API_URL=http://127.0.0.1:5000
FLASK_INTERNAL_KEY=REPLACE_WITH_LONG_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
FLASK_SECRET_KEY=REPLACE_WITH_DIFFERENT_LONG_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
FLASK_DEBUG=0
# Issued in Google Cloud Console for the exact deployed domain.
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_ACTUAL_GOOGLE_CLIENT_ID
# Resend verified sending domain needed; never put real key in tracked files.
RESEND_API_KEY=REPLACE_WITH_YOUR_ACTUAL_RESEND_API_KEY
EMAIL_FROM="Parish Office <no-reply@parish.example.com>"
# Keep TEST until hosted checkout, callbacks, and reconciliation pass.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=REPLACE_WITH_SK_TEST_KEY
PAYMONGO_WEBHOOK_SECRET=REPLACE_WITH_TEST_WEBHOOK_SIGNING_SECRET
PAYMONGO_METHODS=card,qrph
PAYMONGO_LIVE_ENABLED=NO
CERT_FEES_APPROVED=NO
# Actual church-approved fees in whole Philippine pesos, never invented amounts.
CERT_FEE_BAPTISMAL=
CERT_FEE_CONFIRMATION=
CERT_FEE_MARRIAGE=
CERT_FEE_OWNERSHIP=
CERT_FEE_LAND_AGREEMENT=
CERT_FEE_URGENT=
# Do not provision staff credentials through a permanent environment file.
