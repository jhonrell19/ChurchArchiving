# Render staging reference. Enter real values in Render Environment.
# Flask: use the existing imported database; Render generates the two Flask keys.
ARCHIVE_POSTGRES_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
APP_BASE_URL=https://YOUR-WEB-SERVICE.onrender.com
SMART_PARISH_UPLOAD_ROOT=/var/data/uploads
HF_HOME=/var/data/model-cache
PAYMONGO_MODE=test
PAYMONGO_METHODS=qrph
PAYMONGO_SECRET_KEY=
# Next.js: use the same current Google client ID for both settings.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
STAFF_MFA_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
PAYMONGO_WEBHOOK_SECRET=

# Feature flags — intentionally disabled until migrations and real gateway tests pass.
# smart-parish-api (Flask): enable only after authorized physical cash collection
# and both cash receipt SQL migrations have been applied.
PARISH_CASH_RECEIPTS=disabled

# ifimarag (Next.js): change each flag only after textbee / Resend test.
PHONE_OTP_PROVIDER=textbee
TEXTBEE_OTP_ENABLED=false
PHONE_OTP_PEPPER=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_SIM_SLOT_INDEX=0
PARISH_STATUS_NOTIFICATIONS=disabled
PARISH_STATUS_AUTO_SEND=disabled
PARISH_NOTIFICATION_SMS=disabled
PARISH_NOTIFICATION_EMAIL=disabled
