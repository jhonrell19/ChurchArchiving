[Unit]
Description=Smart Parish Next.js
After=network.target
[Service]
Type=simple
User=smartparish
Group=smartparish
WorkingDirectory=/opt/smartparish
EnvironmentFile=/etc/smartparish/production.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectHome=true
[Install]
WantedBy=multi-user.target
