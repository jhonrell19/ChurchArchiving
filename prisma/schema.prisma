// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas = ["parish_auth"]
}

enum Role {
  USER
  ADMIN
  BURIAL_ADMIN
  STAFF

  @@schema("parish_auth")
}

model User {
  id Int @id @default(autoincrement())

  firstName  String?
  middleName String?
  surname    String?

  // Contact number only. It is not used as a login identity.
  phoneNumber String?
  address     String?

  email    String @unique
  password String

  role Role @default(USER)

  // Church administrator must approve each parishioner after email verification.
  membershipStatus String @default("pending")
  membershipReviewedAt DateTime?
  membershipReviewedById Int?
  membershipReviewReason String?

  emailVerified Boolean @default(false)
  accountEnabled Boolean @default(true)

  // Google is the only external sign-in provider.
  googleSub String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  staffMfa                StaffMfa?
  staffMfaChallenges      StaffMfaChallenge[]
  phoneVerification       PhoneVerification?
  notificationPreference  NotificationPreference?
  notificationEvents      NotificationEvent[]

  @@schema("parish_auth")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])

  @@schema("parish_auth")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])

  @@schema("parish_auth")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])

  @@schema("parish_auth")
}

model StaffMfa {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  secretEncrypted   String
  recoveryCodesJson String
  lastUsedStep      Int      @default(-1)
  confirmedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("parish_auth")
}

model StaffMfaChallenge {
  id                   Int      @id @default(autoincrement())
  userId               Int
  tokenHash            String   @unique
  setupSecretEncrypted String?
  attempts             Int      @default(0)
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])

  @@schema("parish_auth")
}

model PhoneVerification {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  phoneNumber     String
  otpHash         String?
  expiresAt       DateTime?
  lastSentAt      DateTime?
  sendWindowStart DateTime?
  sendsInWindow   Int       @default(0)
  attempts        Int       @default(0)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("parish_auth")
}

/**
 * Opt-in service updates; phone verification alone never authorizes broadcast.
 * Email-only service updates default on, SMS defaults OFF until the user opts in.
 */
model NotificationPreference {
  userId       Int      @id
  smsUpdates   Boolean  @default(false)
  emailUpdates Boolean  @default(true)
  updatedAt    DateTime @updatedAt @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("parish_auth")
}

/**
 * Provider acceptance is not handset delivery. An immutable unique eventKey
 * prevents PayMongo webhook replays and repeated staff requests from sending
 * duplicate notices; pending events can be flushed by authorized staff.
 */
model NotificationEvent {
  id               Int      @id @default(autoincrement())
  userId           Int
  requestId        Int
  office           String   @default("main") @db.VarChar(16)
  kind             String   @db.VarChar(40)
  eventKey         String   @unique @db.VarChar(64)
  message          String   @db.VarChar(350)
  emailState       String   @default("pending") @db.VarChar(20)
  smsState         String   @default("pending") @db.VarChar(20)
  emailAttemptedAt DateTime?
  smsAttemptedAt   DateTime?
  smsBatchId       String?  @db.VarChar(128)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([office, smsState, emailState])
  @@schema("parish_auth")
}
